# 環境変数
.env

# データ（data/README.md のみ管理対象）
data/*
!data/README.md

# DuckDB
*.duckdb

# 画像キャッシュ（Mapillary / オルソ / LOD2 テクスチャの取得物）
data/cache/
*.image_cache/

# 画像（docs/ と web/ の静的ファイルは除く）
*.jpg
*.jpeg
*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.png
!web/**/*.jpg
!web/**/*.jpeg
!web/**/*.png

# Python
__pycache__/
.venv/

# Node
node_modules/
